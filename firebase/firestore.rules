rules_version = '2';
// DESPLEGADO el 24-nov-2026 tal cual (online v3 de salas de varios, feedback y netlogs con exp), SALVO repOk de feedback (denuncias,
// 25-nov-2026, rama legal): eso está SIN DESPLEGAR. Ojo: hasta fusionar online-multi
// en main, las reglas de main NO llevan el esquema v3: no despliegues las de main o quitarías las salas de varios.
// Make the Cut: progreso de cada cuenta. Sin cifrar; solo lo lee y lo cambia su dueño.
// users/{uid}/saves/{key}: data = JSON en texto (≤ 400 000 caracteres; js/account.js no sube más de 390 000); updatedAt = ms del dispositivo.
// Claves admitidas (11; todas desplegadas el 16-nov-2026) y qué las enciende en js/account.js:
//   squad, career, settings, record   → siempre (DOCS).                                  DESPLEGADAS.
//   gym                               → GYM_SYNC = true (12-nov-2026).                    DESPLEGADA el 12-nov-2026.
//   look                              → LOOK_SYNC = true (Vestuario, 13-nov-2026).        DESPLEGADA el 15-nov-2026.
//   profile, career6, cmode, legends, retos → S4_SYNC (S4, perfil y sincronización).       DESPLEGADAS el 16-nov-2026.
// Orden obligatorio: 1) Ferran despliega estas reglas (npx firebase-tools deploy --only firestore:rules, desde firebase/) y espera unos
// minutos; 2) en una publicación mínima, S4_SYNC = true (LOOK_SYNC ya está a true). Al revés, cada subida daría 403.
// '<clave>.bak', 'make-the-cut.career(6).prev', 'make-the-cut.devid' y 'make-the-cut.retostab' son del aparato: nunca llegan aquí.
// tools/synctest.js comprueba que cada clave de DOCS (con todos los interruptores encendidos) está en la lista de abajo.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/saves/{key} {
      allow get, list, delete: if owner(uid);
      allow create, update: if owner(uid)
        && key in ['squad', 'career', 'settings', 'record', 'gym', 'look', 'profile', 'career6', 'cmode', 'legends', 'retos']
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'v'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 400000
        && request.resource.data.updatedAt is number
        && (!('v' in request.resource.data) || request.resource.data.v is int);
    }
    // ------------------------------------------------------------------------------------------------------------------------
    // ONLINE (especialista net, notes/net.md, 16-nov-2026). DESPLEGADO el 16-nov-2026. Si faltaran estas reglas, el juego diría
    // «El online aún no está activado en el servidor» al entrar en Online (403 al listar rooms) y no se rompe nada más.
    // Desplegar (desde firebase/): npx firebase-tools deploy --only firestore:rules
    //
    // rooms/{uid}: la sala que tiene abierta cada cuenta (el id del documento ES el uid del anfitrión: una sala por cuenta).
    //   Campos públicos para la lista del lobby (los ve cualquiera con sesión; nunca correos): code (6 letras/cifras, para compartir),
    //   name (nombre visible del anfitrión, 1-16), gname (el de quien entra), host/guest (uid), fmt ('2v2'), venue ('beach'|'hall'),
    //   map (id de la sede), even (Igualado), bo (1|3 sets), pts, state ('open' en la lista | 'full' con rival | 'play' jugando),
    //   v (versión del protocolo y del juego) y seen (hora del SERVIDOR del último latido del anfitrión: el cliente la manda como
    //   transformación REQUEST_TIME, así no depende del reloj de nadie).
    //   - Crear / cambiar: solo el anfitrión (doc = su uid) y con seen = hora del servidor.
    //   - Unirse: quien no es el anfitrión, a una sala 'open', vacía y viva (latido de hace < 90 s); solo toca guest/gname/state.
    //   - Salir antes de empezar: el invitado devuelve la sala a 'open'.
    //   - Borrar: el anfitrión, o cualquiera con sesión si la sala lleva más de 5 min sin latido (limpieza desde el lobby).
    // rooms/{uid}/sig/{offer|answer}: señalización de WebRTC (SDP, que lleva direcciones de red): SOLO la leen y escriben los dos
    //   jugadores de la sala (offer el anfitrión, con to = uid del invitado al que va; answer el invitado, con uid = el suyo) y cada
    //   uno solo lee lo que va dirigido a él: un invitado nuevo nunca lee la respuesta (ni la oferta) de uno anterior. El cliente la
    //   borra al conectar, al salir el invitado y al volver a abrir la sala. Nada de esto se enseña en el juego: del rival solo se ve
    //   su nombre.
    // ESQUEMA v3, SALAS DE VARIOS (online multi, 21-nov-2026; notes/online-multi-brief.md §4). DESPLEGADO el 24-nov-2026. Aditivo: las salas
    //   1v1 (sin la clave cap) siguen exactamente con las reglas de arriba (los clientes 1.21.0 en caché no notan nada). Una sala de
    //   varios lleva además mode ('vs'|'coop'), cap (plazas humanas con el anfitrión: 2|4|12), seats ({uid: {n, at}}: los invitados;
    //   at = hora del servidor), cnt (invitados que el anfitrión da por dentro, 0..cap-1) y lineup opcional (texto del anfitrión);
    //   fmt '2v2'|'6v6' (6v6 solo en 'hall'; cap 12 solo en 6v6; coop: cap 2, o 4 en 6v6; Fluida solo vs con cap 2); guest/gname ''.
    //   net (opcional): 'fluida' (solo vs, cap 2, 2v2) | 'host' (modelo del anfitrión: 6v6, o vs 2v2 de 4 plazas).
    //   Estado de una sala de varios: 'open' (vs, en la lista) | 'coop' (coop esperando compañero: NUNCA 'open', así un cliente 1.21.0
    //   en caché, que lista y busca por código solo state == 'open', no la ve) | 'full' | 'play'.
    //   - Crear / cambiar: el anfitrión, con roomOkMulti (seats vacío y cnt 0 al crear; 'open' si es vs, 'coop' si es coop).
    //   - Sentarse: quien no es el anfitrión, en una sala de varios 'open' (o 'coop') y viva; SOLO toca seats.<su uid> = {n, at = hora
    //     del servidor} y como mucho cap-1 invitados; no si su uid está en ban (mapa opcional del anfitrión, uid → true, ≤ 20: a quien
    //     saca con «Sacar de la sala»). Levantarse: solo su propia clave, con la sala 'open', 'coop' o 'full' (en 'play' no).
    //   - Las ramas 1v1 de entrar no valen en una sala de varios.
    //   rooms/{uid}/sig/o_<uidInvitado> (oferta del anfitrión) y sig/a_<uidInvitado> (respuesta de ese invitado) = {sdp, gen}:
    //   señalización por pareja. Lee o_: el anfitrión y ese invitado; lee a_: ese invitado y el anfitrión mientras siga sentado.
    //   Escribir: solo para un invitado sentado (el anfitrión su o_, el invitado su a_). Borrar: anfitrión, ese invitado, o cualquiera
    //   si la sala ya no existe o está caducada.
    // ------------------------------------------------------------------------------------------------------------------------
    function signed() { return request.auth != null; }
    function nameOk(n) { return n is string && n.size() >= 1 && n.size() <= 16; }
    function roomOk(d) {
      return d.keys().hasOnly(['code', 'name', 'gname', 'host', 'guest', 'fmt', 'venue', 'map', 'even', 'bo', 'pts', 'state', 'v', 'seen', 'net'])
        && d.keys().hasAll(['code', 'name', 'gname', 'host', 'guest', 'fmt', 'venue', 'map', 'even', 'bo', 'pts', 'state', 'v', 'seen'])
        && d.code is string && d.code.matches('[2-9A-HJKMNP-Z]{6}')
        && nameOk(d.name) && d.gname is string && d.gname.size() <= 16
        && d.host is string && d.guest is string && d.guest.size() <= 128
        && d.fmt in ['2v2'] && d.venue in ['beach', 'hall'] && d.map is string && d.map.size() <= 40
        && d.even is bool && d.bo in [1, 3] && d.pts in [11, 15, 21, 25]
        && d.state in ['open', 'full', 'play'] && d.v is string && d.v.size() <= 40
        && d.seen == request.time
        // Online V2: 'net' es opcional (sin la clave = conexión Precisa); si está, solo 'fluida'
        && (!('net' in d) || d.net in ['fluida']);
    }
    // esquema v3: sala de varios (la marca es la clave cap; las 1v1 no la tienen)
    function multi(d) { return 'cap' in d; }
    function roomOkMulti(d) {
      return d.keys().hasOnly(['code', 'name', 'gname', 'host', 'guest', 'fmt', 'venue', 'map', 'even', 'bo', 'pts', 'state', 'v', 'seen', 'net',
            'mode', 'cap', 'seats', 'cnt', 'lineup', 'ban'])
        && d.keys().hasAll(['code', 'name', 'gname', 'host', 'guest', 'fmt', 'venue', 'map', 'even', 'bo', 'pts', 'state', 'v', 'seen',
            'mode', 'cap', 'seats', 'cnt'])
        && d.code is string && d.code.matches('[2-9A-HJKMNP-Z]{6}')
        && nameOk(d.name) && d.gname == '' && d.host is string && d.guest == ''
        && d.fmt in ['2v2', '6v6'] && d.venue in ['beach', 'hall'] && (d.fmt == '2v2' || d.venue == 'hall')
        && d.map is string && d.map.size() <= 40
        && d.even is bool && d.bo in [1, 3] && d.pts in [11, 15, 21, 25]
        && d.v is string && d.v.size() <= 40
        && d.seen == request.time
        && multiMode(d)
        && d.seats is map && d.seats.size() <= d.cap - 1
        && d.cnt is int && d.cnt >= 0 && d.cnt <= d.cap - 1
        && (!('lineup' in d) || (d.lineup is string && d.lineup.size() <= 4000))
        // ban (opcional, solo lo escribe el anfitrión al sacar a alguien con «Sacar de la sala»): uid → true, como mucho 20
        && (!('ban' in d) || (d.ban is map && d.ban.size() <= 20));
    }
    // modo, plazas, estado y conexión de una sala de varios. (L3: con ternarios a propósito; las mismas condiciones escritas como
    // (a != x || b == y) o con || de varios && hacen que el emulador falle al validar las reglas, HTTP 500; tools/roomtest.js lo pilla)
    function multiMode(d) {
      return d.mode in ['vs', 'coop'] && d.cap in [2, 4, 12]
        // estado: una coop nunca 'open' (los clientes 1.21.0 solo listan / buscan 'open') y 'coop' solo en las coop
        && (d.mode == 'coop' ? d.state in ['coop', 'full', 'play'] : d.state in ['open', 'full', 'play'])
        && (d.cap <= 4 || d.fmt == '6v6')
        && (d.mode == 'vs' || d.cap == 2 || (d.cap == 4 && d.fmt == '6v6'))
        // net: 'host' (modelo del anfitrión) en 6v6 o con 4 plazas (2v2 de 4: solo vs, la coop de 4 es 6v6); 'fluida' solo vs 2v2 de 2
        && (!('net' in d) || (d.net == 'host' ? (d.fmt == '6v6' || d.cap == 4) : (d.net in ['fluida'] && d.mode == 'vs' && d.cap == 2 && d.fmt == '2v2')));
    }
    // una plaza: solo el nombre visible y la hora del servidor (transformación REQUEST_TIME)
    function seatOk(s) { return s is map && s.keys().hasOnly(['n', 'at']) && s.keys().hasAll(['n', 'at']) && nameOk(s.n) && s.at == request.time; }
    function members(d) { return [d.host, d.guest]; }
    function live(d) { return d.seen > request.time - duration.value(90, 's'); }
    function stale(d) { return d.seen < request.time - duration.value(300, 's'); }
    match /rooms/{rid} {
      allow get: if signed();
      allow list: if signed() && request.query.limit <= 50;
      allow create: if signed() && rid == request.auth.uid && roomOk(request.resource.data)
        && request.resource.data.host == request.auth.uid && request.resource.data.guest == '' && request.resource.data.gname == ''
        && request.resource.data.state == 'open'
        // esquema v3: o una sala de varios recién abierta (sin invitados)
        || signed() && rid == request.auth.uid && roomOkMulti(request.resource.data) && request.resource.data.host == request.auth.uid
          && request.resource.data.get('seats', {}).size() == 0 && request.resource.data.get('cnt', -1) == 0 && request.resource.data.state in ['open', 'coop'];
      allow update: if signed() && (
        // el anfitrión: lo que quiera de su sala (latido, estado, echar al invitado), siempre válida y con seen del servidor
        (rid == request.auth.uid && resource.data.host == request.auth.uid && request.resource.data.host == request.auth.uid
          && roomOk(request.resource.data))
        // entrar: una sala abierta, vacía y viva; solo guest (= quien entra), gname y state ('full')
        || (resource.data.state == 'open' && resource.data.guest == '' && resource.data.host != request.auth.uid && live(resource.data)
          && !multi(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'gname', 'state'])
          && request.resource.data.guest == request.auth.uid && request.resource.data.state == 'full' && nameOk(request.resource.data.gname))
        // salir antes de empezar: el invitado deja la sala abierta y vacía
        || (resource.data.state == 'full' && resource.data.guest == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'gname', 'state'])
          && request.resource.data.guest == '' && request.resource.data.gname == '' && request.resource.data.state == 'open')
        // esquema v3, el anfitrión de una sala de varios: lo que quiera (latido, estado, cnt, levantar a alguien), siempre válida
        || (rid == request.auth.uid && resource.data.host == request.auth.uid && request.resource.data.host == request.auth.uid
          && roomOkMulti(request.resource.data))
        // esquema v3, sentarse: sala de varios abierta (o coop esperando) y viva, si no te sacaron (ban); solo seats.<tu uid> = {n, at
        // del servidor}; como mucho cap-1 invitados
        || (multi(resource.data) && resource.data.state in ['open', 'coop'] && resource.data.host != request.auth.uid && live(resource.data)
          // (no si el anfitrión le sacó: ban. Con el ternario sobre resource == null a propósito: un upsert evalúa también esta rama sin
          //  documento y, escrito de otra forma, el emulador da HTTP 500; tools/roomtest.js lo pilla)
          && (resource == null ? true : !(request.auth.uid in resource.data.get('ban', {})))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats'])
          && request.resource.data.get('seats', {}).diff(resource.data.get('seats', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.auth.uid in request.resource.data.get('seats', {}) && seatOk(request.resource.data.get('seats', {})[request.auth.uid])
          && request.resource.data.get('seats', {}).size() <= resource.data.get('cap', 0) - 1)
        // esquema v3, levantarse antes de empezar: solo tu clave (en 'play' no: la vuelta tras recargar necesita la plaza)
        || (multi(resource.data) && resource.data.state in ['open', 'coop', 'full'] && request.auth.uid in resource.data.get('seats', {})
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats'])
          && request.resource.data.get('seats', {}).diff(resource.data.get('seats', {})).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.get('seats', {}))));
      allow delete: if signed() && (resource.data.host == request.auth.uid || stale(resource.data));
      match /sig/{kind} {
        function room() { return get(/databases/$(database)/documents/rooms/$(rid)).data; }
        function here() { return exists(/databases/$(database)/documents/rooms/$(rid)); }
        // esquema v3: documentos por pareja o_<uid> / a_<uid>; peer() = el uid del invitado de la pareja
        function pair() { return kind.matches('[oa]_[A-Za-z0-9_-]{1,128}'); }
        function offerP() { return kind.matches('o_.+'); }
        function peer() { return kind[2:kind.size()]; }
        function seated(u) { return multi(room()) && u in room().get('seats', {}); }
        // leer: la oferta, el anfitrión o su destinatario (to); la respuesta, quien la escribió (uid) o el anfitrión mientras ese
        // sea su invitado. Así nadie hereda la SDP de otro (quien entra después de que alguien saliera no puede leer la suya).
        // (resource == null: el documento no existe y la lectura da 404, no 403)
        allow get: if signed() && here() && (resource == null
          || (kind == 'offer' && (room().host == request.auth.uid || resource.data.to == request.auth.uid))
          || (kind == 'answer' && (resource.data.uid == request.auth.uid
                || (room().host == request.auth.uid && resource.data.uid == room().guest)))
          // esquema v3: o_ la lee el anfitrión y ese invitado; a_ ese invitado y el anfitrión mientras siga sentado
          || (pair() && multi(room()) && (peer() == request.auth.uid
                || (room().host == request.auth.uid && (offerP() || seated(peer()))))));
        allow create, update: if signed() && here() && ((room().state in ['full', 'play']
          && ((kind == 'offer' && room().host == request.auth.uid && request.resource.data.keys().hasOnly(['sdp', 'gen', 'to'])
                && request.resource.data.to == room().guest)
            || (kind == 'answer' && room().guest == request.auth.uid && request.resource.data.keys().hasOnly(['sdp', 'gen', 'uid'])
                && request.resource.data.uid == request.auth.uid)))
          // esquema v3: por pareja, solo para un invitado sentado: o_ el anfitrión, a_ ese invitado; solo {sdp, gen}
          || (pair() && seated(peer()) && request.resource.data.keys().hasOnly(['sdp', 'gen'])
            && ((offerP() && room().host == request.auth.uid) || (!offerP() && peer() == request.auth.uid))))
          && request.resource.data.keys().hasAll(['sdp', 'gen'])
          && request.resource.data.sdp is string && request.resource.data.sdp.size() <= 20000
          && request.resource.data.gen is int && request.resource.data.gen >= 0;
        // borrar: los dos jugadores, quien escribió la respuesta aunque ya haya salido (al cerrar la pestaña el borrado y la salida
        // van a la vez) y cualquiera si la sala ya no existe o está caducada
        allow delete: if signed() && (!here() || request.auth.uid in members(room()) || stale(room())
          || (resource != null && resource.data.get('uid', '') == request.auth.uid)
          || (pair() && peer() == request.auth.uid));
      }
    }
    // La cuenta de Ferran: SHA-256 del correo (el mismo que js/ui.js usa para el acta; el correo no va en el repo, que es público).
    // La usan netlogs (leer) y feedback (leer y cambiar el estado). Estaba dentro de netlogs; 23-nov-2026 sale a este nivel con el mismo
    // resultado (token.get: una cuenta sin correo da false en vez de un error de evaluación, que en una consulta salía como 500).
    // (va aquí, tras el bloque ONLINE y no arriba del todo: tools/roomtest.js prueba también las reglas sin ese bloque y, sin nadie
    // que la use, el emulador avisa de función sin usar y con Java en castellano ese aviso sale como error 500)
    function admin() {
      return request.auth != null && request.auth.token.get('email', null) is string
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower() == 'c0592685221ed4a093808f6d3f8a863be6f6d4a1894b00b91e90b07719048deb';
    }
    // Informes de red de los partidos online (js/netlog.js, 17-nov-2026): uno por partido y jugador, escrito UNA vez al acabar con su
    // cuenta. Crear/actualizar: solo el propio (id = uid_xxx, campo uid), 4 campos, j ≤ 250 000 caracteres. Leer: solo la cuenta de
    // Ferran (admin(), arriba). Nadie borra desde el cliente.
    // Caducidad (Google Play, 24-nov-2026; DESPLEGADA el 24-nov-2026): 'exp' opcional, timestamp en el futuro y como mucho ahora + 100 días (el
    // cliente manda ahora + 90 con su reloj: un reloj atrasado da una caducidad antes, nunca después de 100 días). La borra una
    // política TTL de Firestore sobre netlogs.exp (notes/net.md «Caducidad de los informes»). Sigue opcional porque los clientes de
    // 1.22.0 no lo mandan; cuando ya no queden, hacerlo obligatorio (hasAll con 'exp'). Con las reglas de antes, un informe con exp
    // da 403 y js/netlog.js lo repite sin exp; al cerrar la pestaña no hay reintento y solo manda exp si sabe que se acepta.
    match /netlogs/{id} {
      function logOk(d) {
        return d.keys().hasOnly(['uid', 'ver', 't', 'j', 'exp']) && d.keys().hasAll(['uid', 'ver', 't', 'j'])
          && d.uid == request.auth.uid && d.ver is string && d.ver.size() <= 20 && d.t is timestamp
          && d.j is string && d.j.size() <= 250000
          && (!('exp' in d) || (d.exp is timestamp && d.exp > request.time
                && d.exp <= request.time + duration.value(100, 'd')));
      }
      allow get, list: if admin();
      allow create: if request.auth != null && id.matches(request.auth.uid + '_[0-9a-z]{4,24}') && logOk(request.resource.data);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && logOk(request.resource.data);
    }
    // ------------------------------------------------------------------------------------------------------------------------
    // FEEDBACK (1.22.1, 23-nov-2026; js/feedback.js, notes/feedback.md): sugerencias y bugs que mandan los jugadores desde el juego.
    // DESPLEGADO el 24-nov-2026. Si un envío falla (sin red, 403…), el juego lo guarda en la cola del aparato
    // ('make-the-cut.feedbackq') y lo vuelve a probar al arrancar y al volver la red.
    // feedback/{id}: id aleatorio de 20 letras y cifras (16-32 admitidas). Campos:
    //   kind ('sug' | 'bug'), text (5-2000), where (opcional: 'partido' | 'carrera' | 'online' | 'menus' | 'otro'), ver (≤ 20, la
    //   versión del juego), ctx (JSON en texto ≤ 4000: navegador, sistema, pantalla, calidad, idioma, dónde estaba y, en los bugs, los
    //   últimos errores; nunca correo, IP ni nombre), uid (el de la cuenta si hay sesión; '' sin sesión), t (= hora del SERVIDOR: el
    //   cliente la manda con la transformación REQUEST_TIME), state ('nuevo' al crear).
    //   - Crear: con o sin sesión (sin sesión, uid ''; con sesión, uid = el suyo), con esos campos y tamaños exactos.
    //   - Leer y listar: solo admin(). Cambiar: solo admin() y solo state ('nuevo' | 'visto' | 'hecho' | 'descartado') y note (≤ 1000),
    //     desde pages/feedback.html. Nadie borra desde el cliente.
    // ------------------------------------------------------------------------------------------------------------------------
    match /feedback/{id} {
      function fbOk(d) {
        return d.keys().hasOnly(['kind', 'text', 'where', 'ver', 'ctx', 'uid', 't', 'state'])
          && d.keys().hasAll(['kind', 'text', 'ver', 'ctx', 'uid', 't', 'state'])
          && d.kind in ['sug', 'bug']
          && d.text is string && d.text.size() >= 5 && d.text.size() <= 2000
          && (!('where' in d) || d.where in ['partido', 'carrera', 'online', 'menus', 'otro'])
          && d.ver is string && d.ver.size() <= 20
          && d.ctx is string && d.ctx.size() <= 4000
          && d.uid is string && ((request.auth == null && d.uid == '') || (request.auth != null && d.uid == request.auth.uid))
          && d.t == request.time
          && d.state == 'nuevo';
      }
      // DENUNCIAS (auditoría legal, 25-nov-2026; js/report.js, «Denunciar nombre»; SIN DESPLEGAR: hasta desplegarlas, la denuncia da 403 y
      // el juego dice «No se ha podido enviar»). Aditivo: las sugerencias y bugs de arriba no cambian. kind 'report' y SOLO con sesión:
      //   uid (quien denuncia = su cuenta), ru (uid denunciado, 1-128, no el suyo), rn (su nombre tal cual llegó, ≤ 40), room (código de
      //   la sala, ≤ 12), ver (≤ 20), t (= hora del servidor), state 'nuevo' y exp (timestamp en el futuro y como mucho ahora + 200 días;
      //   el cliente manda + 180: la borra una política TTL sobre feedback.exp, que hay que activar como la de netlogs). Lee y cambia el
      //   estado solo admin(), con las mismas reglas de abajo.
      function repOk(d) {
        return d.keys().hasOnly(['kind', 'uid', 'ru', 'rn', 'room', 'ver', 't', 'state', 'exp'])
          && d.keys().hasAll(['kind', 'uid', 'ru', 'rn', 'room', 'ver', 't', 'state', 'exp'])
          && d.kind == 'report'
          && request.auth != null && d.uid == request.auth.uid
          && d.ru is string && d.ru.size() >= 1 && d.ru.size() <= 128 && d.ru != request.auth.uid
          && d.rn is string && d.rn.size() <= 40
          && d.room is string && d.room.size() <= 12
          && d.ver is string && d.ver.size() <= 20
          && d.t == request.time
          && d.state == 'nuevo'
          && d.exp is timestamp && d.exp > request.time && d.exp <= request.time + duration.value(200, 'd');
      }
      allow create: if id.matches('[A-Za-z0-9]{16,32}') && (fbOk(request.resource.data) || repOk(request.resource.data));
      allow get, list: if admin();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'note'])
        && request.resource.data.state in ['nuevo', 'visto', 'hecho', 'descartado']
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 1000));
    }
  }
}
